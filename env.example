# Copy to .env.local. Never commit real values.
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_GATEWAY=https://gateway.pinata.cloud
# Mainnet read RPC (or http://127.0.0.1:8545 for the anvil fork demo)
BSC_RPC_URL=https://bsc-rpc.publicnode.com
# Archive RPC used by forge fork tests / anvil fork
FORK_RPC_URL=https://bsc-mainnet.public.blastapi.io
# Your deployed AgentLaunchpad
LAUNCHPAD_ADDRESS=
NEXT_PUBLIC_LAUNCHPAD_ADDRESS=
LAUNCHPAD_DEPLOY_BLOCK=
DATA_SOURCE_LABEL=BSC mainnet
# Optional: require this key (header x-api-key) on POST /api/upload
AGENT_API_KEY=
